{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infra-advisor-ai.kyletaylor.dev/contracts/chat-artifacts/procurement-opportunities.v1.schema.json",
  "title": "Procurement opportunities chat artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "status", "generated_at", "items", "meta"],
  "properties": {
    "kind": { "const": "procurement_opportunities" },
    "schema_version": { "const": "1.0" },
    "tool_name": { "type": "string", "maxLength": 100 },
    "tool_call_id": { "type": ["string", "null"], "maxLength": 200 },
    "status": { "enum": ["ok", "partial", "empty", "error"] },
    "generated_at": { "type": "string", "format": "date-time", "maxLength": 50 },
    "items": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/opportunity" } },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["returned_count", "provider_counts", "truncated", "partial_errors"],
      "properties": {
        "returned_count": { "type": "integer", "minimum": 0, "maximum": 20 },
        "provider_counts": { "type": "object", "maxProperties": 2, "propertyNames": { "enum": ["sam.gov", "grants.gov"] }, "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 20 } },
        "truncated": { "type": "boolean" },
        "partial_errors": { "type": "array", "maxItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["provider", "code", "retriable"], "properties": { "provider": { "enum": ["sam.gov", "grants.gov"] }, "code": { "type": "string", "maxLength": 100 }, "retriable": { "type": "boolean" } } } }
      }
    }
  },
  "$defs": {
    "opportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "provider_id", "opportunity_type", "title", "agency", "summary", "status", "posted_at", "deadline_at", "location", "classifications", "funding", "source", "data_quality"],
      "allOf": [
        { "if": { "properties": { "provider": { "const": "sam.gov" } }, "required": ["provider"] }, "then": { "properties": { "opportunity_type": { "const": "contract" } } } },
        { "if": { "properties": { "provider": { "const": "grants.gov" } }, "required": ["provider"] }, "then": { "properties": { "opportunity_type": { "const": "grant" } } } }
      ],
      "properties": {
        "id": { "type": "string", "maxLength": 300 }, "provider": { "enum": ["sam.gov", "grants.gov"] }, "provider_id": { "type": "string", "maxLength": 200 }, "opportunity_type": { "enum": ["contract", "grant"] }, "title": { "type": "string", "maxLength": 500 },
        "agency": { "type": "object", "additionalProperties": false, "required": ["name", "code"], "properties": { "name": { "type": "string", "maxLength": 500 }, "code": { "type": ["string", "null"], "maxLength": 100 } } },
        "summary": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "maxLength": 100 },
        "posted_at": { "anyOf": [{ "type": "null" }, { "type": "string", "format": "date", "maxLength": 10 }, { "type": "string", "format": "date-time", "maxLength": 50 }] },
        "deadline_at": { "anyOf": [{ "type": "null" }, { "type": "string", "format": "date", "maxLength": 10 }, { "type": "string", "format": "date-time", "maxLength": 50 }] },
        "location": { "type": "object", "additionalProperties": false, "required": ["state_code", "state_name", "city"], "properties": { "state_code": { "type": ["string", "null"], "maxLength": 20 }, "state_name": { "type": ["string", "null"], "maxLength": 200 }, "city": { "type": ["string", "null"], "maxLength": 200 } } },
        "classifications": { "type": "object", "additionalProperties": false, "required": ["naics", "assistance_listing", "set_aside"], "properties": { "naics": { "type": "array", "maxItems": 20, "items": { "type": "string", "pattern": "^\\d{2,6}$", "maxLength": 6 } }, "assistance_listing": { "type": "array", "maxItems": 20, "items": { "type": "string", "pattern": "^\\d{2}\\.\\d{3}$", "maxLength": 6 } }, "set_aside": { "type": ["string", "null"], "maxLength": 200 } } },
        "funding": { "type": "object", "additionalProperties": false, "required": ["currency", "minimum", "maximum", "total", "expected_awards"], "properties": { "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "maxLength": 3 }, "minimum": { "type": ["number", "null"], "minimum": 0, "maximum": 1000000000000000 }, "maximum": { "type": ["number", "null"], "minimum": 0, "maximum": 1000000000000000 }, "total": { "type": ["number", "null"], "minimum": 0, "maximum": 1000000000000000 }, "expected_awards": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000000 } } },
        "source": { "type": "object", "additionalProperties": false, "required": ["url", "retrieved_at"], "properties": { "url": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 1000 }] }, "retrieved_at": { "type": "string", "format": "date-time", "maxLength": 50 } } },
        "data_quality": { "type": "object", "additionalProperties": false, "required": ["missing_fields"], "properties": { "missing_fields": { "type": "array", "maxItems": 20, "items": { "enum": ["title", "agency.name", "deadline_at", "source.url", "funding.total"] } } } }
      }
    }
  }
}
