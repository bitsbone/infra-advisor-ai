<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="InfraAdvisor.Mobile.Resources.Styles.Colors">
    <!-- Shared web-aligned palette. Semantic names keep page XAML independent from individual color values. -->
    <Color x:Key="Primary">#1D4ED8</Color>
    <Color x:Key="PrimaryDark">#1E3A8A</Color>
    <Color x:Key="PrimarySoft">#DBEAFE</Color>
    <Color x:Key="Accent">#7C3AED</Color>
    <Color x:Key="Canvas">#F8FAFC</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="Border">#CBD5E1</Color>
    <Color x:Key="TextPrimary">#0F172A</Color>
    <Color x:Key="TextSecondary">#475569</Color>
    <Color x:Key="Success">#15803D</Color>
    <Color x:Key="SuccessSoft">#ECFDF5</Color>
    <Color x:Key="Warning">#B45309</Color>
    <Color x:Key="Danger">#B91C1C</Color>
    <Color x:Key="DangerSoft">#FEE2E2</Color>
    <!-- Field Advisor semantic palette: calm, high-contrast colors suited to field use and evidence review. -->
    <Color x:Key="FieldNavy">#17324D</Color>
    <Color x:Key="FieldNavySoft">#E8EEF4</Color>
    <Color x:Key="FieldTeal">#0F766E</Color>
    <Color x:Key="FieldTealSoft">#CCFBF1</Color>
    <Color x:Key="EvidenceAmber">#B45309</Color>
    <Color x:Key="EvidenceAmberSoft">#FEF3C7</Color>
    <Color x:Key="Overlay">#99112435</Color>
</ResourceDictionary>
