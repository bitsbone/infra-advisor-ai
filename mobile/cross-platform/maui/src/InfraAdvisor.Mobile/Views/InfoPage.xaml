<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:InfraAdvisor.Mobile.ViewModels;assembly=InfraAdvisor.Mobile.Presentation"
    x:Class="InfraAdvisor.Mobile.Views.InfoPage"
    x:DataType="viewModels:InfoViewModel"
    Title="Info"
    AutomationId="InfoPage">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16" MaximumWidthRequest="720">
            <Label Text="App &amp; Observability" Style="{StaticResource PageTitle}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Profile" Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding Email}" FontAttributes="Bold" />
                    <Label Text="User ID" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    <Label Text="{Binding UserId}" LineBreakMode="CharacterWrap" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Datadog" Style="{StaticResource SectionTitle}" />
                    <Label Text="Service" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    <Label Text="{Binding Service}" />
                    <Label Text="Site / environment" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    <Label Text="{Binding Site}" />
                    <Label Text="{Binding Environment}" />
                    <Label Text="Sampling" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    <Label Text="{Binding Sampling}" />
                    <Label Text="Session Replay privacy" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    <Label Text="{Binding ReplayPrivacy}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Application" Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding ApiBaseUrl}" LineBreakMode="CharacterWrap" />
                    <Label Text="{Binding Version, StringFormat='Version {0}'}" />
                </VerticalStackLayout>
            </Border>
            <Label Text="Client tokens, JWTs, prompts, responses, filenames, and upload URLs are intentionally omitted from this screen and from custom telemetry." FontSize="12" TextColor="{StaticResource TextSecondary}" />
            <Button Text="Logout" Command="{Binding LogoutCommand}" Style="{StaticResource DangerButton}" AutomationId="Logout" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
