<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:InfraAdvisor.Mobile.ViewModels;assembly=InfraAdvisor.Mobile.Presentation"
    x:Class="InfraAdvisor.Mobile.Views.ErrorLabPage"
    x:DataType="viewModels:ErrorLabViewModel"
    Title="Errors"
    IconImageSource="tab_errors.png"
    SafeAreaEdges="Container"
    AutomationId="ErrorLabPage">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16" MaximumWidthRequest="720">
            <Label Text="Errors" Style="{StaticResource PageTitle}" />
            <Label Text="Controlled examples for validating Datadog logs, errors, resources, and crash symbolication." TextColor="{StaticResource TextSecondary}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Non-fatal telemetry" Style="{StaticResource SectionTitle}" />
                    <Button Text="Send sample logs" Command="{Binding SendSampleLogsCommand}" Style="{StaticResource SecondaryButton}" SemanticProperties.Hint="Sends sanitized example logs to Datadog" AutomationId="SendSampleLogs" />
                    <Button Text="Capture handled app error" Command="{Binding TriggerHandledErrorCommand}" Style="{StaticResource SecondaryButton}" SemanticProperties.Hint="Records a handled example error without closing the app" AutomationId="TriggerHandledError" />
                    <Button Text="Trigger API response error" Command="{Binding TriggerApiErrorCommand}" Style="{StaticResource SecondaryButton}" SemanticProperties.Hint="Makes a controlled request that returns an API error" AutomationId="TriggerApiError" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}" Stroke="#FCA5A5" IsVisible="{Binding CrashAvailable}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Crash reporting" Style="{StaticResource SectionTitle}" TextColor="{StaticResource Danger}" />
                    <Label Text="This immediately terminates the process. Relaunch the app to let Datadog upload the native crash report, then verify symbols for version 0.1.0." TextColor="{StaticResource TextSecondary}" />
                    <Button Text="Crash app now" Clicked="OnCrashClicked" Style="{StaticResource DangerButton}" SemanticProperties.Hint="Shows a confirmation before intentionally terminating the app" AutomationId="CrashApp" />
                </VerticalStackLayout>
            </Border>
            <Label Text="{Binding ResultMessage}" IsVisible="{Binding HasResult}" TextColor="{StaticResource Success}" SemanticProperties.Description="Diagnostics result" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
