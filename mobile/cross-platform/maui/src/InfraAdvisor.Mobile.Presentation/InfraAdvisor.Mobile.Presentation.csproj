<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>InfraAdvisor.Mobile</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Build-only Source Link metadata maps portable-PDB frames to the matching GitHub source revision. -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../InfraAdvisor.Mobile.Core/InfraAdvisor.Mobile.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../InfraAdvisor.Mobile/Models/ChatPresentationModels.cs" Link="Models/ChatPresentationModels.cs" />
    <Compile Include="../InfraAdvisor.Mobile/Observability/IObservability.cs" Link="Observability/IObservability.cs" />
    <Compile Include="../InfraAdvisor.Mobile/Services/Media/IMediaInputService.cs" Link="Services/Media/IMediaInputService.cs" />
    <Compile Include="../InfraAdvisor.Mobile/ViewModels/*.cs" Link="ViewModels/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
