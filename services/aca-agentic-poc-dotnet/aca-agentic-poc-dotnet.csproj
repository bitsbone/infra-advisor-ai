<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- Build-only Source Link metadata lets Datadog resolve portable-PDB stack frames to this GitHub repository and commit. -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400" PrivateAssets="all" />

    <!-- Same package set as services/agent-api-dotnet — this app is a
         deliberately minimal subset (no MCP, no Redis, no Postgres, no
         evaluators) of that service's pattern, not a rewrite of it. -->
    <PackageReference Include="Azure.AI.OpenAI" Version="2.9.0-beta.1" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.6.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.6.0" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.6.0" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.6.0" />

    <!-- Pure OpenTelemetry SDK — no dd-trace-dotnet in either the
         managed-agent or serverless-init-sidecar deployment of this app.
         See TelemetrySetup.cs for why this app lets the SDK's own env-var
         auto-configuration pick gRPC vs HTTP/protobuf, rather than hardcoding
         one like agent-api-dotnet does — the same binary must work
         correctly against both OTel-to-Datadog paths this POC compares. -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
  </ItemGroup>
</Project>
