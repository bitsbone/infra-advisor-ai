# Azure
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=eastus

# Azure Authentication — used by `azure/login` GitHub Action
## Service Principal JSON (base64-encoded) — see https://docs.microsoft.com/en-us/cli/azure/create-an-azure-service-principal-azure-cli
AZURE_CREDENTIALS=
## OpenID Connect (OIDC) — see https://docs.microsoft.com/en-us/azure/developer/github/connect-from-azure?tabs=azure-cli
AZURE_CLIENT_ID=
AZURE_TENANT_ID=

# Azure Container App (basic auth)
ACA_UI_USERNAME=
ACA_UI_PASSWORD=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.4-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EVAL_DEPLOYMENT_NAME=gpt-4.1-nano
AZURE_OPENAI_MAX_RETRIES=5
EVAL_SAMPLE_RATE=0.1

# Azure AI Search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=infra-advisor-knowledge

# Azure Storage — chat-media container (image/audio attachment uploads).
AZURE_STORAGE_CONNECTION_STRING=

# GitHub Container Registry
GHCR_USERNAME=
GHCR_PAT=                              # GitHub PAT with read:packages scope — used by make create-ghcr-secret
# placeholder
# placeholder
GITHUB_EMAIL=                          # Your GitHub account email — used by make create-ghcr-secret
GHCR_IMAGE_PREFIX=ghcr.io/username/infra-advisor-ai

# Datadog
DD_API_KEY=
DD_APP_KEY=
DD_APPLICATION_KEY=
DD_SITE=us3.datadoghq.com

# Datadog RUM (UI only)
VITE_DD_RUM_APP_ID=
VITE_DD_RUM_CLIENT_TOKEN=
VITE_DD_RUM_SITE=us3.datadoghq.com

# EIA (free key from eia.gov)
EIA_API_KEY=

# ERCOT (free key from ercot.com)
ERCOT_API_KEY=

# SAM.GOV (Free at api.sam.gov — full key including SAM- prefix)
SAMGOV_API_KEY=

# Internal K8s DNS (leave these as-is; they are used by the load generator and other internal services)
REDIS_HOST=redis.infra-advisor.svc.cluster.local
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=kafka-cluster-kafka-bootstrap.kafka.svc.cluster.local:9092
KAFKA_QUERY_TOPIC=infra.query.events
KAFKA_EVAL_TOPIC=infra.eval.results
MCP_SERVER_URL=http://mcp-server.infra-advisor.svc.cluster.local:8000/mcp
AGENT_API_URL=http://agent-api.infra-advisor.svc.cluster.local:8001

# Postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DD_POSTGRES_PASSWORD=
DATABASE_URL=
JWT_SECRET=

# Airflow
AIRFLOW_WEBSERVER_SECRET_KEY=
AIRFLOW_ADMIN_USERNAME=
AIRFLOW_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Mailpit
MAILPIT_UI_USERNAME=superuser
MAILPIT_UI_PASSWORD=Password1!

# Load generator
QUERIES_PER_RUN_MIN=2
QUERIES_PER_RUN_MAX=4
LOAD_GEN_QUERIES_PER_RUN=15
LOAD_GEN_HAPPY_PATH_PCT=70
LOAD_GEN_EDGE_CASE_PCT=20
LOAD_GEN_ADVERSARIAL_PCT=10

# External data sources
TWDB_WATER_PLAN_WORKBOOK_URL=https://www.twdb.texas.gov/waterplanning/data/rwp-database/index.asp
EPA_SDWIS_BASE_URL=https://enviro.epa.gov/enviro/efservice

# Datadog MAUI RUM (public; shared by Android and iOS)
MAUI_DD_RUM_APPLICATION_ID=fe90f908-da00-4d7c-9b24-6af11cee68a4
MAUI_DD_CLIENT_TOKEN=pub884d0800477e2d252b992acb168fc7a5

# GitHub Actions secrets for Mobile App Testing
DATADOG_SYNTHETICS_MAUI_ANDROID_APPLICATION_ID=
DATADOG_SYNTHETICS_MAUI_IOS_APPLICATION_ID=

# GitHub Actions secrets for signed MAUI builds
# Base64-encoded iOS Development or Ad Hoc certificate
MAUI_IOS_SIGNING_CERTIFICATE_BASE64=
MAUI_IOS_SIGNING_CERTIFICATE_PASSWORD=
APP_STORE_CONNECT_KEY_ID=
