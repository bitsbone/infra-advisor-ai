---
interface Props {
    title?: string;
    eyebrow?: string;
}

const { title = 'What you will learn', eyebrow = 'Learning objectives' } = Astro.props;
---

<aside class="learning-objectives">
    <p class="learning-objectives__eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    <div class="learning-objectives__content"><slot /></div>
</aside>

<style>
    .learning-objectives {
        margin-block: 1.75rem 2.25rem;
        padding: 1.35rem 1.5rem;
        border: 1px solid color-mix(in srgb, var(--sl-color-accent) 30%, var(--sl-color-gray-5));
        border-radius: 1rem;
        background: linear-gradient(135deg, color-mix(in srgb, var(--sl-color-accent-low) 65%, transparent), transparent 72%);
    }
    .learning-objectives__eyebrow { margin: 0 0 0.35rem; color: var(--sl-color-accent-high); font-size: 0.72rem; font-weight: 750; letter-spacing: 0.1em; text-transform: uppercase; }
    .learning-objectives h2 { margin: 0; font-size: clamp(1.1rem, 2vw, 1.35rem); }
    .learning-objectives__content { margin-top: 0.75rem; }
    .learning-objectives__content :global(ul) { margin-block: 0; }
</style>
