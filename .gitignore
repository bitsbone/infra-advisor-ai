# Secrets — never commit real credentials
.env
.env.local
.env.*.local
*.bak

# Deploy logs contain plaintext secrets from kubectl create secret output
*.log

# Claude Code local settings (project settings.json is committed)
.claude/settings.local.json
graphify-out/

# Local MCP server config (may contain token references)
.mcp.json

# IDE / editor
.vscode/
.idea/
*.swp

# Bits AI local settings
.bits/

# Azure
azure.json

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.venv/
.ruff_cache/

# Node / frontend
node_modules/
dist/
.next/

# Data files
*.parquet
*.csv
*.xlsx

# .NET build artifacts
bin/
obj/
*.user
*.suo
.vs/
TestResults/
*.nupkg
*.snupkg
**/*.binlog
publish/

# Build artifacts
*.tar.gz
*.zip
**/build/
**/.gradle/
**/DerivedData/
**/Pods/
**/*.xcworkspace/xcuserdata/
**/*.xcodeproj/xcuserdata/
mobile/native/ios/Config/Local.xcconfig
mobile/native/android/local.properties

# macOS
.DS_Store

# Terraform / Bicep state
*.tfstate
*.tfstate.backup
.terraform/

# Kubernetes generated files
kubeconfig
**/kubeconfig*

# Certificates and keys
*.pem
*.key
*.crt
*.p12
*.pfx

# Security audit reports — kept local so the public repo doesn't ship
# a catalog of weaknesses until they're remediated.
security-audit-*.md
